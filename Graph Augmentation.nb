            "]"}], ",", "\n", "    ", "1"}], "\n", "  ", "]"}]}], ";", "\n", 
       "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Define", " ", "fixed", " ", "point"}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"point1", " ", "=", " ", 
