Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "parameters"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"simulateConditions", "[", 
     RowBox[{"n_", ",", " ", "s_", ",", " ", "esum_", ",", " ", "emax_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "m", ",", " ", "cond1", ",", " ", "cond2", ",", " ", "cond3", ",", " ",
         "cond4", ",", " ", "criteria"}], "}"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Step", " ", "1"}], ":", " ", 
        RowBox[{"Set", " ", "initial", " ", "m", " ", 
         RowBox[{"(", 
          RowBox[{"Conditions", " ", "1", " ", "and", " ", "3"}], ")"}]}]}], 
       " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"esum", "/", "s"}], "]"}], ",", " ", "emax"}], "]"}]}], 
       ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Define", " ", "the", " ", "four", " ", "conditions"}], " ", 
        "*)"}], "\n", "  ", 
       RowBox[{"cond1", " ", ":=", " ", 
        RowBox[{
         RowBox[{"m", "*", "s"}], " ", ">=", " ", "esum"}]}], ";", "\n", "  ", 
       RowBox[{"cond2", " ", ":=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"s", " ", "+", " ", "1"}], ")"}], "*", "m"}], " ", "+", 
          " ", "esum"}], " ", ">=", " ", "0"}]}], ";", "\n", "  ", 
       RowBox[{"cond3", " ", ":=", " ", 
        RowBox[{"m", " ", ">=", " ", "emax"}]}], ";", "\n", "  ", 
       RowBox[{"cond4", " ", ":=", " ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", " ", "+", " ", "n"}], ")"}], "*", "s"}], ",", " ", 
           "2"}], "]"}], " ", "==", " ", "0"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"criteria", " ", ":=", " ", 
        RowBox[{
        "cond1", " ", "&&", " ", "cond2", " ", "&&", " ", "cond3", " ", "&&", 
         " ", "cond4"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"While", " ", "the", " ", "criteria", " ", "fail"}], ",", 
         " ", 
         RowBox[{"increment", " ", "m"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"!", "criteria"}], ",", " ", 
         RowBox[{"m", "++"}]}], "]"}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Return", " ", "the", " ", "minimal", " ", "m", " ", "that", " ", 
         "satisfies", " ", "all", " ", "conditions"}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"{", "m", "}"}]}]}], "\n", "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Example", " ", "usage", " ", "1"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nrNodes", " ", "=", " ", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sparsity", " ", "=", " ", 
     RowBox[{"nrNodes", " ", "-", " ", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxe", " ", "=", " ", "sparsity"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totale", " ", "=", " ", "maxe"}], ";"}], "\n", 
   RowBox[{"simulateConditions", "[", 
    RowBox[{
    "nrNodes", ",", " ", "sparsity", ",", " ", "totale", ",", " ", "maxe"}], 
    "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Example", " ", "usage", " ", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nrNodes", " ", "=", " ", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sparsity", " ", "=", " ", 
     RowBox[{"nrNodes", " ", "-", " ", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxe", " ", "=", " ", 
     RowBox[{"sparsity", " ", "-", " ", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totale", " ", "=", " ", 
     RowBox[{"maxe", "*", 
      RowBox[{"(", 
       RowBox[{"nrNodes", " ", "-", " ", "1"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"simulateConditions", "[", 
    RowBox[{
    "nrNodes", ",", " ", "sparsity", ",", " ", "totale", ",", " ", "maxe"}], 
    "]"}]}]}]], "Code",
 CellChangeTimes->{
