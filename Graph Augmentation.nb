Cell[TextData[{
 "Simulate ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "4cdce47e-038c-2742-8b12-50f22da7e9d5"],
 ", given subgraph conditions."
}], "Section",
 CellChangeTimes->{{3.9490542219974384`*^9, 3.949054230066601*^9}, {
