Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Definition", ":", " ", 
    RowBox[{"Upper", " ", "bound", " ", "for", " ", "m"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mUpper", "[", 
      RowBox[{"d_", ",", " ", "s_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", " ", "+", " ", "1", " ", "+", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", " ", "+", " ", "1"}], ")"}], "^", "2"}], " ", "-", 
          " ", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"l", " ", "+", " ", "s"}], ")"}]}]}], "]"}]}], ")"}], " ",
       "/", " ", "2"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Definition", ":", " ", 
     RowBox[{"Lower", " ", "bound", " ", "for", " ", "m", " ", 
      RowBox[{"(", 
       RowBox[{"ceiling", " ", "function"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mLower", "[", 
      RowBox[{"d_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Ceiling", "[", 
      RowBox[{"s", "/", "d"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Region", " ", "Plot", " ", "with", " ", "interactive", " ", "l", " ", 
     "parameter"}], " ", "*)"}], "\n", 
   RowBox[{"Manipulate", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"RegionPlot3D", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"m", "^", "2"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", " ", "+", " ", "1"}], ")"}], " ", "m"}], " ", "+", 
          " ", 
          RowBox[{"(", 
           RowBox[{"l", " ", "+", " ", "s"}], ")"}]}], " ", ">=", " ", "0"}], 
        " ", "&&", " ", 
        RowBox[{"m", " ", ">=", " ", 
         RowBox[{"mLower", "[", 
          RowBox[{"d", ",", " ", "s"}], "]"}]}]}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"Both", " ", "conditions"}], " ", "*)"}], "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"d", ",", " ", "20", ",", " ", "5000"}], "}"}], ",", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Range", " ", "for", " ", "d", " ", 
         RowBox[{"(", "degree", ")"}]}], " ", "*)"}], "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"s", ",", " ", "500", ",", " ", "500000"}], "}"}], ",", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Range", " ", "for", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"missing", " ", "connections", " ", "sum"}], ")"}]}], " ", 
        "*)"}], "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "1000"}], "}"}], ",", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Range", " ", "for", " ", "m", " ", 
         RowBox[{"(", 
          RowBox[{"number", " ", "of", " ", "extra", " ", "nodes"}], ")"}]}], 
        " ", "*)"}], "\n", "    ", 
       RowBox[{"PlotPoints", " ", "->", " ", "50"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"Increase", " ", "resolution"}], " ", "*)"}], "\n", "    ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<d\>\"", ",", " ", "\"\<s\>\"", ",", " ", "\"\<m\>\""}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"Opacity", "[", 
         RowBox[{"0.5", ",", " ", "Blue"}], "]"}]}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Shade", " ", "valid", " ", "region", " ", "in", " ", "blue"}], " ", 
        "*)"}], "\n", "    ", 
       RowBox[{"Mesh", " ", "->", " ", "None"}], ",", "\n", "    ", 
       RowBox[{"BoundaryStyle", " ", "->", " ", 
