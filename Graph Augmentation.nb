Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "parameters"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"simulateConditions", "[", 
     RowBox[{"n_", ",", " ", "d_", ",", " ", "e_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "s", ",", " ", "m", ",", " ", "l", ",", " ", "valid", ",", " ", 
        "step3Condition", ",", " ", "sumDegreesEven"}], "}"}], ",", "\n", 
      "  ", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Step", " ", "1"}], ":", " ", 
        RowBox[{
        "Compute", " ", "s", " ", "and", " ", "set", " ", "initial", " ", 
         "m"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"s", " ", "=", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"d", " ", "-", " ", "k"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], ";",
        " ", 
       RowBox[{"(*", " ", 
        RowBox[{"Missing", " ", "connections", " ", "sum"}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"s", "/", "d"}], "]"}], ",", " ", "e"}], "]"}]}], ";", 
       "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Lower", " ", "bound", " ", "on", " ", "m"}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"l", " ", "=", " ", "0"}], ";", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Start", " ", "with", " ", "no", " ", "self"}], "-", 
         "loops"}], " ", "*)"}], "\n", "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Step", " ", "2"}], ":", " ", 
         RowBox[{
         "Adjust", " ", "parity", " ", "condition", " ", "for", " ", "sum", 
          " ", "of", " ", "degrees"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"sumDegreesEven", " ", "=", " ", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"m", " ", "+", " ", "n"}], ")"}], " ", "d"}], " ", "+", 
            " ", "l"}], ",", " ", "2"}], "]"}], " ", "==", " ", "0"}]}], ";", 
       "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "sumDegreesEven"}], ",", " ", 
         RowBox[{"l", " ", "=", " ", "1"}]}], "]"}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Ensure", " ", 
          RowBox[{"(", 
           RowBox[{"m", "+", "n"}], ")"}], "d"}], " ", "+", " ", 
         RowBox[{"l", " ", "is", " ", "even"}]}], " ", "*)"}], "\n", "\n", 
       "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Step", " ", "3"}], ":", " ", 
         RowBox[{
          RowBox[{"Check", " ", "intra"}], "-", 
          RowBox[{"link", " ", "condition"}]}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"step3Condition", " ", ":=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"m", " ", 
           RowBox[{"(", 
            RowBox[{"m", " ", "-", " ", "1"}], ")"}]}], " ", "+", " ", "l"}], 
         " ", ">=", " ", 
         RowBox[{
          RowBox[{"m", " ", "d"}], " ", "-", " ", "s"}]}]}], ";", "\n", "\n", 
       "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Adjust", " ", "l", " ", "until", " ", "condition", " ", "is", " ", 
          "met", " ", "or", " ", "l"}], " ", "=", " ", "m"}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "step3Condition"}], " ", "&&", " ", 
          RowBox[{"l", " ", "<", " ", "m"}]}], ",", " ", 
         RowBox[{"l", " ", "+=", " ", "2"}]}], "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Step", " ", "4"}], ":", " ", 
          RowBox[{"If", " ", "condition", " ", "still", " ", "fails"}]}], ",",
          " ", 
         RowBox[{"increment", " ", "m"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"!", "step3Condition"}], ",", " ", "\n", "    ", 
         RowBox[{
          RowBox[{"m", " ", "+=", " ", "1"}], ";", "\n", "    ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"m", " ", "+", " ", "n"}], ")"}], " ", "d"}], " ", 
                "+", " ", "l"}], ",", " ", "2"}], "]"}], " ", "!=", " ", 
             "0"}], ",", " ", 
            RowBox[{"l", " ", "=", " ", "1"}], ",", " ", 
            RowBox[{"l", " ", "=", " ", "0"}]}], "]"}], ";", " ", 
          RowBox[{"(*", " ", 
           RowBox[{"Adjust", " ", "parity"}], " ", "*)"}], "\n", "    ", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", "step3Condition"}], " ", "&&", " ", 
             RowBox[{"l", " ", "<", " ", "m"}]}], ",", " ", 
            RowBox[{"l", " ", "+=", " ", "2"}]}], "]"}], ";"}]}], "\n", "  ", 
        "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Final", " ", "output"}], " ", "*)"}], "\n", "  ", 
       RowBox[{"valid", " ", "=", " ", "step3Condition"}], ";", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "l", ",", " ", "s", ",", " ", "valid"}], 
        "}"}]}]}], "\n", "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Example", " ", "usage"}], " ", "*)"}], "\n", 
   RowBox[{"simulateConditions", "[", 
    RowBox[{"10", ",", " ", "5", ",", " ", "3"}], "]"}], "\n"}]}]], "Code",
