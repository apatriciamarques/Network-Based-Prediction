Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["m", "TI"], "\[LessEqual]", 
        FractionBox[
         RowBox[{
           StyleBox["d", "TI"], "+", "1", "+", 
           SqrtBox[
            RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["d", "TI"], "+", "1"}], ")"}], "2"], "-", "4", 
              RowBox[{"(", 
                RowBox[{
                  StyleBox["l", "TI"], "+", 
                  StyleBox["s", "TI"]}], ")"}]}]]}], "2"]}], TraditionalForm],
     "errors" -> {}, "input" -> 
    "m \\leq \\frac{d+1 + \\sqrt{(d+1)^2 - 4(l+s)}}{2}\n", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"58e8f508-e8b9-fe48-a7b7-8bfe71cd5e91"]], \
