        "*)"}], "\n", "    ", 
       RowBox[{"Boxed", " ", "->", " ", "True"}]}], "\n", "  ", "]"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"l", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
    " ", 
    RowBox[{"(*", " ", 
     RowBox[{"Slider", " ", "for", " ", 
      RowBox[{"l", ":", " ", 
       RowBox[{"0", " ", "or", " ", "1"}]}]}], " ", "*)"}], "\n", 
    "]"}]}]}]], "Code",
