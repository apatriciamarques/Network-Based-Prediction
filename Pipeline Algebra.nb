Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating allSuperposedStates...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allSuperposedStates", " ", "=", " ", 
    RowBox[{"Join", "[", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ":", " ", 
         RowBox[{"pad", " ", "to", " ", 
          RowBox[{"2", "^", "5"}], " ", "*", " ", 
          RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"5", "+", 
           RowBox[{"2", "m"}]}], ")"}]}]}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}], ",",
                " ", 
               RowBox[{
                RowBox[{"2", "^", "5"}], " ", "*", " ", 
                RowBox[{"s", "^", "2"}]}]}], "]"}]}], "\n", "      ", 
            "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", "    ", 
        "firstHopSuperposedStates"}], "\n", "  ", "]"}], ",", "\n", "\n", 
      "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"2", ":", " ", 
         RowBox[{"already", " ", "full", " ", "size"}]}]}], " ", "*)"}], "\n",
       "  ", 
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", 
        "    ", "secondHopSuperposedStates"}], "\n", "  ", "]"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Map", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"assoc", ",", "\n", "    ", 
      RowBox[{"<|", "\n", "      ", 
       RowBox[{
        RowBox[{"\"\<c\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<c\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<i\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<i\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<stateLengthPadded\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"assoc", "[", "\"\<statePadded\>\"", "]"}], "]"}]}]}], "\n",
        "    ", "|>"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{"allSuperposedStates", ",", " ", 
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&"}]}], "]"}]}], "\n", 
   "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#statePadded", "]"}], "]"}], " ", "&"}], ",", 
     " ", "allSuperposedStates"}], "]"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.9608991289948063`*^9, 3.960899164932129*^9}, {
