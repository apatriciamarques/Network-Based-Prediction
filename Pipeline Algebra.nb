             "\n", "        ", 
             RowBox[{
             "\"\<stateDegreeRotated\>\"", " ", "->", " ", "finalState"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", "groupedByVI"}], "\n", "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"firstHopSuperposedStates", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&&", " ", 
