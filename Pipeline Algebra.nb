}], "Chapter",
 CellChangeTimes->{{3.9609582443139496`*^9, 
  3.9609582480355663`*^9}},ExpressionUUID->"01121e3b-fb2f-984e-ad02-\
2a8e500acb33"],

Cell[TextData[{
 StyleBox["Both neighborhoods: ",
  FontWeight->"Bold"],
 "For each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["v", "TI"], TraditionalForm], "errors" -> {}, "input" -> "v", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "919f42b5-868e-f54a-b0ca-d0553e136d7d"],
 ", get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", 
          RowBox[{"(", 
            RowBox[{"5", "+", "3"}], ")"}]], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "2^(5+3)s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cbf87107-c776-7b4e-b496-5dce7f4cbefd"],
 " = 128x8=1024 (unit-length)."
}], "Text",
 CellChangeTimes->{{3.9609610040929966`*^9, 
  3.9609610439154263`*^9}},ExpressionUUID->"1116f1da-b663-cf4a-ad34-\
fee8c833c458"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Group", " ", "all", " ", "states", " ", "by", " ", "v"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"vectorsByV", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"allSuperposedStates", ",", " ", 
       RowBox[{"#v", " ", "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"For", " ", "each", " ", "v"}], ",", " ", 
     RowBox[{
      RowBox[{"build", " ", "the", " ", "concatenated", " ", "super"}], "-", 
      RowBox[{
      "long", " ", "vector", " ", "by", " ", "joining", " ", "statePadded", 
       " ", "vectors", " ", "in", " ", "order"}]}]}], " ", "*)"}], "\n", 
   RowBox[{"Print", "[", "\"\<Creating superLongVectorsByV...\>\"", "]"}], 
   "\n", 
   RowBox[{
    RowBox[{"superLongVectorsByV", " ", "=", " ", 
     RowBox[{"Association", "[", "\n", "  ", 
      RowBox[{"KeyValueMap", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "assocList"}], "}"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{"lookup", " ", "=", " ", 
            RowBox[{"Association", "[", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"#c", ",", " ", "#i"}], "}"}], " ", "->", " ", 
                 "#"}], " ", "&"}], ",", " ", "assocList"}], "]"}], "]"}]}], 
           ";", "\n", "      ", "\n", "      ", 
           RowBox[{"concatenatedVector", " ", "=", " ", 
            RowBox[{"Flatten", "[", "\n", "        ", 
             RowBox[{
              RowBox[{"Table", "[", "\n", "          ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"KeyExistsQ", "[", 
                   RowBox[{"lookup", ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"c", ",", " ", "i"}], "}"}]}], "]"}], ",", "\n", 
                  "            ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"lookup", "[", 
                    RowBox[{"{", 
                    RowBox[{"c", ",", " ", "i"}], "}"}], "]"}], "[", 
                    "\"\<statePadded\>\"", "]"}], " ", "/", " ", 
                   RowBox[{"Sqrt", "[", "8", "]"}]}], ",", "  ", 
                  RowBox[{"(*", " ", 
                   RowBox[{"superposition", " ", "in", " ", 
                    RowBox[{"(", 
                    RowBox[{"c", ",", "i"}], ")"}]}], " ", "*)"}], "\n", 
                  "            ", 
                  RowBox[{"{", "}"}]}], "\n", "          ", "]"}], ",", "\n", 
                "          ", 
                RowBox[{"{", 
                 RowBox[{"c", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "1", ",", " ", "4"}], "}"}]}], "\n", 
               "        ", "]"}], ",", "\n", "        ", "Infinity"}], "\n", 
             "      ", "]"}]}], ";", "\n", "      ", "\n", "      ", 
           RowBox[{"v", " ", "->", " ", "concatenatedVector"}]}]}], "\n", 
         "    ", "]"}], ",", "\n", "    ", "vectorsByV"}], "\n", "  ", "]"}], 
      "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Norm", " ", "/@", " ", 
       RowBox[{"Values", "[", "superLongVectorsByV", "]"}]}], " ", "//", " ", 
      RowBox[{"Print", " ", "Norm"}]}], " ", "=", " ", 
     RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Print", "[", 
     RowBox[{"Dimensions", " ", "/@", " ", 
      RowBox[{"Values", "[", "superLongVectorsByV", "]"}]}], "]"}], " ", 
    "*)"}], "\n", 
   RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}]}]], "Code",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQfWeVz4q3TW8dDdzKtoLoFubjO0H0jglGe0F0jOXc
gyD6xuLTYJohSugYiL5QkXkWLN6jcQlM82heAdEFd/Vvgs25YAeme6q9T74D
0gdOrzgFotfsdb4KonnYMsG0wGVPrvdA+s3Bdh4QveBMiACIrvi2SghE//n+
