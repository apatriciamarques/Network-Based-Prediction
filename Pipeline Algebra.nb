          RowBox[{"Total", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"trainLabels", "[", 
               RowBox[{"[", "idxs", "]"}], "]"}]}], ")"}], " ", "*", " ", 
            RowBox[{"wV", "[", 
             RowBox[{"[", "idxs", "]"}], "]"}], " ", "*", " ", 
            RowBox[{"kernelMatrix", "[", 
             RowBox[{"[", 
              RowBox[{"v", ",", " ", "idxs"}], "]"}], "]"}]}], "\n", "      ",
            "]"}]}], "\n", "    ", "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", 
          RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}]}], "\n", "  ", 
