   3.9608829574418144`*^9}, {3.9608830117833614`*^9, 
   3.9608830145420475`*^9}, {3.960883075057825*^9, 3.960883230917492*^9}, {
   3.960883302607395*^9, 3.960883341426735*^9}, {3.960883381232012*^9, 
   3.960883383132105*^9}, {3.9608834907993183`*^9, 3.9608835215965347`*^9}, {
   3.960883552723646*^9, 3.96088355355702*^9}, {3.960883593666662*^9, 
   3.9608835950399284`*^9}, {3.960883668759823*^9, 3.9608836827362556`*^9}, {
   3.9608837396483994`*^9, 3.9608837472895927`*^9}, {3.96088382169446*^9, 
   3.9608838224765472`*^9}, {3.960884081734947*^9, 3.9608840975819416`*^9}, {
   3.9608855129474583`*^9, 3.96088551391543*^9}, {3.960960003094124*^9, 
   3.9609600217863827`*^9}, {3.9609600578278522`*^9, 3.960960062422447*^9}, {
   3.9609631602382374`*^9, 3.9609631626560555`*^9}, 3.960963862733593*^9, {
   3.960976663715328*^9, 3.9609766670924377`*^9}, {3.960977303883255*^9, 
   3.9609773042081375`*^9}, {3.9609778080153847`*^9, 3.9609778081476326`*^9}, 
   3.960979110290491*^9},
