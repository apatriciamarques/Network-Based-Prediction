  3.960884350836025*^9}},ExpressionUUID->"fd543ce7-4948-ec4f-8824-\
4d9ada1ebecf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<Creating firstHopStates...\>\"", "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"firstHopStates", " ", "=", " ", 
    RowBox[{
     RowBox[{"Reap", "[", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"featVec", " ", "=", " ", 
          RowBox[{
           RowBox[{"GetFeatureRotation", "[", 
            RowBox[{"v", ",", " ", "l"}], "]"}], " ", ".", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}]}]}], ";", "\n", "    ", "\n", 
         "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Precompute", " ", "all", " ", "Kronecker", " ", "combinations", 
           " ", "once", " ", "for", " ", "each", " ", "featVec"}], " ", 
          "*)"}], "\n", "    ", 
         RowBox[{"vectListBase", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
            RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "    ", "\n", 
         "    ", 
         RowBox[{"Do", "[", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"vectList", " ", "=", " ", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"vectListBase", ",", " ", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"k", " ", "->", " ", "featVec"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", " ", "1", ",", " ", "i"}], "}"}]}], 
                "]"}]}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"combinedVec", " ", "=", " ", 
             RowBox[{
              RowBox[{"Fold", "[", 
               RowBox[{"KroneckerProduct", ",", " ", 
                RowBox[{"First", "[", "vectList", "]"}], ",", " ", 
                RowBox[{"Rest", "[", "vectList", "]"}]}], "]"}], " ", "//", 
              " ", "Flatten"}]}], ";", "\n", "      ", "\n", "      ", 
            RowBox[{"Sow", "[", 
             RowBox[{"<|", "\n", "        ", 
              RowBox[{
               RowBox[{"\"\<v\>\"", " ", "->", " ", "v"}], ",", "\n", 
               "        ", 
               RowBox[{"\"\<i\>\"", " ", "->", " ", "i"}], ",", "\n", 
               "        ", 
               RowBox[{"\"\<l\>\"", " ", "->", " ", "l"}], ",", "\n", 
               "        ", 
               RowBox[{"\"\<u\>\"", " ", "->", " ", 
                RowBox[{"adjacencyList", "[", 
                 RowBox[{"[", 
                  RowBox[{"v", ",", " ", "l"}], "]"}], "]"}]}], ",", "\n", 
               "        ", 
               RowBox[{"\"\<featVec\>\"", " ", "->", " ", "featVec"}], ",", 
               "\n", "        ", 
               RowBox[{"\"\<state\>\"", " ", "->", " ", "combinedVec"}]}], 
              "\n", "      ", "|>"}], "]"}]}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "4"}], "}"}]}], "\n", 
          "    ", "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", "1", ",", " ", "nrNodes"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "1", ",", " ", "s"}], "}"}]}], "\n", "  ", 
       "]"}], "\n", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"firstHopStates", " ", "//", " ", "TableForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"firstHopStates", ",", " ", 
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&"}]}], "]"}], " ", "//", 
    " ", "TableForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#state", "]"}], "]"}], " ", "&"}], ",", " ", 
     "firstHopStates"}], "]"}], " ", "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.9573425583666706`*^9, 3.9573427739069195`*^9}, {
   3.9573428844051685`*^9, 3.957342953591305*^9}, {3.95734301859424*^9, 
