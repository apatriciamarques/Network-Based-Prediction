ea3d853fc7af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<Creating FeatureRotation gate...\>\"", "]"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Need", " ", "to", " ", "triple", " ", 
    RowBox[{"check", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetFeatureRotation", "[", 
     RowBox[{"v_Integer", ",", " ", "l_Integer"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "featVal"}], "}"}], ",", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Check", " ", "if", " ", "v", " ", "and", " ", "l", " ", "are", " ", 
        "valid", " ", "indices"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"If", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"1", " ", "<=", " ", "v", " ", "<=", " ", "nrNodes"}], " ", "&&",
          " ", 
         RowBox[{"1", " ", "<=", " ", "l", " ", "<=", " ", 
          RowBox[{"nodeDegrees", "[", 
           RowBox[{"[", "v", "]"}], "]"}]}]}], ",", "\n", "    ", "\n", 
        "    ", 
        RowBox[{
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"adjacencyList", "[", 
           RowBox[{"[", 
            RowBox[{"v", ",", " ", "l"}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"In", " ", "Mathematica"}], ",", " ", 
           RowBox[{"indexing", " ", "starts", " ", "at", " ", "1"}]}], " ", 
          "*)"}], "\n", "    ", 
         RowBox[{"featVal", " ", "=", " ", 
          RowBox[{"featuresNorm", "[", 
           RowBox[{"[", "u", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Wval", "[", "featVal", "]"}]}], ",", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"If", " ", "invalid"}], ",", " ", 
          RowBox[{
          "take", " ", "the", " ", "feature", " ", "value", " ", "to", " ", 
           "be", " ", 
           RowBox[{"zero", "."}]}]}], " ", "*)"}], "\n", "    ", 
        RowBox[{
         RowBox[{"MatrixForm", "[", 
          RowBox[{"Wval", "[", "0", "]"}], "]"}], ";"}]}], "\n", "  ", 
       "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
