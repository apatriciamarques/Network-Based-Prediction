Cell[TextData[{
 StyleBox["Second-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, i), get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", "5"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "2^5s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc365e31-094b-764f-a1b0-0c6758275b78"],
 " = 128 (corresponding to 5 ancilla rotations and the l registers)."
}], "Text",
 CellChangeTimes->{{3.960898703468195*^9, 3.9608987066418514`*^9}, {
  3.960898792484703*^9, 
  3.960898806982731*^9}},ExpressionUUID->"8bca746e-f609-3547-b24b-\
95d05ab7c963"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"groupedByVI2", " ", "=", " ", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"secondHopStates", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#v", ",", " ", "#i"}], "}"}], " ", "&"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Creating secondHopSuperposedStates...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"secondHopSuperposedStates", " ", "=", " ", 
    RowBox[{"KeyValueMap", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"key", ",", " ", "states"}], "}"}], ",", "\n", "    ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c", " ", "=", " ", "2"}], ",", " ", "v", ",", " ", "i", 
            ",", " ", 
            RowBox[{"stateDim", " ", "=", " ", "16"}], ",", " ", 
            "combinedState", ",", " ", "HOnL", ",", " ", "hadState", ",", " ",
             "finalState", ",", " ", "degRotVec"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "i"}], "}"}], " ", "=", " ", "key"}], ";",
            "\n", "      ", "\n", "      ", 
           RowBox[{"combinedState", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"states", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "\"\<state\>\""}], "]"}], "]"}], 
             "]"}]}], ";", "  ", "\n", "\n", "      ", 
           RowBox[{"HOnL", " ", "=", " ", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"Hl", ",", " ", "Hl", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "stateDim", "]"}]}], "]"}]}], 
           ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"16", 
             RowBox[{"s", "^", "2"}], " ", "x", " ", "16", 
             RowBox[{"s", "^", "2"}], " ", "matrix"}], " ", "*)"}], "\n", 
           "      ", 
           RowBox[{"hadState", " ", "=", " ", 
            RowBox[{
             RowBox[{"HOnL", " ", ".", " ", "combinedState"}], " ", "/", " ", 
             "s"}]}], ";", "\n", "\n", "      ", 
           RowBox[{"degRotVec", " ", "=", " ", 
            RowBox[{
             RowBox[{"GetDegreeRotation", "[", 
              RowBox[{"v", ",", " ", "c"}], "]"}], " ", ".", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}]}]}], ";", " ", "\n", 
           "      ", 
           RowBox[{"finalState", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"hadState", ",", " ", "degRotVec"}], "]"}], "]"}]}], 
           ";", " ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "2", " ", "x", " ", "as", " ", "big", " ", "as", " ", "for", " ",
               "c"}], " ", "=", " ", "1"}], " ", "*)"}], "\n", "\n", "      ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{
             RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<v\>\"", " ", "->", " ", "v"}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<i\>\"", " ", "->", " ", "i"}], ",", "\n", 
             "        ", 
             RowBox[{
             "\"\<stateCombined\>\"", " ", "->", " ", "combinedState"}], ",", 
             "\n", "        ", 
             RowBox[{"\"\<stateHadamardL\>\"", " ", "->", " ", "hadState"}], 
             ",", "\n", "        ", 
             RowBox[{"\"\<degRotVec\>\"", " ", "->", " ", "degRotVec"}], ",", 
             "\n", "        ", 
             RowBox[{
             "\"\<stateDegreeRotated\>\"", " ", "->", " ", "finalState"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", "groupedByVI2"}], "\n", "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"secondHopSuperposedStates", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&&", " ", 
       RowBox[{"#i", " ", "==", " ", "4"}]}], " ", "&"}]}], "]"}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#stateDegreeRotated", "]"}], "]"}], " ", "&"}], 
     ",", " ", "secondHopSuperposedStates"}], "]"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.960898245978548*^9, 3.960898246841715*^9}, {
