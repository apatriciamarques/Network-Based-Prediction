Cell[TextData[{
 "Given node v and neighborhood-hop index c, it retrieves the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "x2"}], TraditionalForm]],ExpressionUUID->
  "45274fe0-84d8-b74f-b31a-ab269b893c80"],
 " feature rotation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"K", "^", 
      RowBox[{"{", 
       RowBox[{"-", "1"}], "}"}]}]], "(", "v", ")"}], TraditionalForm]],
  ExpressionUUID->"5e8b55c6-c35a-9a45-8fc8-c0386bcfab4a"],
 " to act on the 1-qubit ancilla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a487c81-a625-4149-9975-e7c9a97edb63"],
 "."
}], "Text",
 CellChangeTimes->{{3.96087306841728*^9, 3.960873100251997*^9}, {
  3.964456057652136*^9, 
  3.9644560611125774`*^9}},ExpressionUUID->"4a2a51e7-c885-fd47-bbad-\
131c060e7662"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating DegreeRotation gate...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GetDegreeRotation", "[", 
    RowBox[{"v_Integer", ",", " ", "c_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"deg", ",", " ", "theta"}], "}"}], ",", "\n", "  ", "\n", "  ", 
     RowBox[{
      RowBox[{"deg", " ", "=", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"c", ",", "\n", "    ", "1", ",", " ", 
         RowBox[{"nodeDegrees", "[", 
          RowBox[{"[", "v", "]"}], "]"}], ",", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "default", " ", "0", " ", "if", " ", "key", " ", "not", " ", 
           "found"}], " ", "*)"}], "\n", "    ", "2", ",", " ", 
         RowBox[{"nodeDegreesC1", "[", 
          RowBox[{"[", "v", "]"}], "]"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "if", " ", "you", " ", "have", " ", "a", " ", "separate", " ", 
            "assoc", " ", "for", " ", "c"}], "=", "2"}], " ", "*)"}], "\n", 
         "    ", "_", ",", " ", 
         RowBox[{"Return", "[", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], "\n", "  ", 
        "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"deg", " ", "<", " ", "1"}], ",", " ", 
        RowBox[{"Return", "[", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], "]"}], ";", "\n",
       "  ", 
      RowBox[{"theta", " ", "=", " ", 
       RowBox[{"2", " ", 
        RowBox[{"ArcCos", "[", 
         RowBox[{"1.0", " ", "/", " ", "deg"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"Wtheta", "[", "theta", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetDegreeRotation", "[", 
   RowBox[{"nodeCheck", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetDegreeRotation", "[", 
   RowBox[{"nodeCheck", ",", " ", "2"}], "]"}], "]"}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->CompressedData["
