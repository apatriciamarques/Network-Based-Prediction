Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", 
  "\"\<Compute scaled features for binary encoding...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", " ", "=", " ", "10"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Precision", " ", "level"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P", " ", "=", " ", 
    RowBox[{"2", "^", "p"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Scaling", " ", "factor"}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"featuresNorm", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"features", " ", "-", " ", 
      RowBox[{"Min", "[", "features", "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Max", "[", "features", "]"}], " ", "-", " ", 
      RowBox[{"Min", "[", "features", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"featuresInt", " ", "=", " ", 
   RowBox[{"Round", "[", 
    RowBox[{"featuresNorm", " ", "*", " ", "P"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"featuresCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"featuresInt", " ", "/", " ", "P"}], " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Max", "[", "features", "]"}], " ", "-", " ", 
       RowBox[{"Min", "[", "features", "]"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"Min", "[", "features", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Error after quantization: \>\"", ",", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"features", " ", "-", " ", "featuresCheck"}], "]"}], "]"}]}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Histogram", "[", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"featuresNorm", ",", " ", 
      RowBox[{
       RowBox[{"#", " ", ">", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", "50",
     ",", " ", "\"\<Count\>\"", ",", "\n", "  ", 
    RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", 
    "  ", 
    RowBox[{"AxesLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<-log10 Mutsig P-values\>\"", ",", " ", "\"\<Frequency\>\""}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{
    "PlotLabel", " ", "->", " ", 
     "\"\<Distribution of featuresNorm: -log10 Mutsig P-values (non-zero \
only)\>\""}]}], "\n", "]"}], "\n"}], "\n", 
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{"featuresInt", ",", " ", 
     RowBox[{
      RowBox[{"#", " ", ">", " ", "0"}], " ", "&"}]}], "]"}], ",", " ", "50", 
   ",", " ", "\"\<Count\>\"", ",", "\n", "  ", 
   RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", "  ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<-log10 Mutsig P-values\>\"", ",", " ", "\"\<Frequency\>\""}], 
     "}"}]}], ",", "\n", "  ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", 
    "\"\<Distribution of featuresInt: -log10 Mutsig P-values (non-zero \
only)\>\""}]}], "\n", "]"}]}], "Code",
 CellChangeTimes->{
  3.9644551790709457`*^9, {3.9644554176284847`*^9, 3.9644554623676987`*^9}, {
   3.964455792289421*^9, 3.964455845799404*^9}, {3.9646032277760487`*^9, 
