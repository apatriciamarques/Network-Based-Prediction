Cell[CellGroupData[{

Cell[TextData[{
 "Feature Embeddings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "x"], "(", 
    RowBox[{"v", ",", "c", ",", "i"}], ")"}], TraditionalForm]],
  ExpressionUUID->"97ff5529-2405-9949-81ef-9454b0ffcf34"]
}], "Chapter",
 CellChangeTimes->{{3.960899094067316*^9, 3.9608991150901794`*^9}, {
  3.960899187035858*^9, 3.9608992443820095`*^9}, {3.960958253353073*^9, 
  3.9609582545334473`*^9}},ExpressionUUID->"65a84079-d60c-2140-803d-\
80d75df4c4e9"],

Cell[TextData[{
 StyleBox["Both neighborhoods: ",
  FontWeight->"Bold"],
 "For each (v, c, i), get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", "5"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "2^5s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac796717-6f58-ed47-9d86-0ca3c8a354a4"],
 " = 128 (padded and unit-length)."
}], "Text",
 CellChangeTimes->{{3.960960947944906*^9, 
  3.960960996325865*^9}},ExpressionUUID->"1d523ca8-8a3d-b642-8647-\
595ab4b3bba2"],

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating allSuperposedStates...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allSuperposedStates", " ", "=", " ", 
    RowBox[{"Join", "[", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ":", " ", 
         RowBox[{"pad", " ", "to", " ", 
          RowBox[{"2", "^", "5"}], " ", "*", " ", 
          RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"5", "+", 
           RowBox[{"2", "m"}]}], ")"}]}]}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}], ",",
                " ", 
               RowBox[{
                RowBox[{"2", "^", "5"}], " ", "*", " ", 
                RowBox[{"s", "^", "2"}]}]}], "]"}]}], "\n", "      ", 
            "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", "    ", 
        "firstHopSuperposedStates"}], "\n", "  ", "]"}], ",", "\n", "\n", 
      "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"2", ":", " ", 
         RowBox[{"already", " ", "full", " ", "size"}]}]}], " ", "*)"}], "\n",
       "  ", 
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", 
        "    ", "secondHopSuperposedStates"}], "\n", "  ", "]"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Map", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"assoc", ",", "\n", "    ", 
      RowBox[{"<|", "\n", "      ", 
       RowBox[{
        RowBox[{"\"\<c\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<c\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<i\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<i\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<stateLengthPadded\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"assoc", "[", "\"\<statePadded\>\"", "]"}], "]"}]}]}], "\n",
        "    ", "|>"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{"allSuperposedStates", ",", " ", 
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&"}]}], "]"}]}], "\n", 
   "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#statePadded", "]"}], "]"}], " ", "&"}], ",", 
     " ", "allSuperposedStates"}], "]"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.9608991289948063`*^9, 3.960899164932129*^9}, {
  3.960899286333946*^9, 3.960899315051464*^9}, {3.960899390388006*^9, 
  3.9608993992378387`*^9}, {3.96095753296541*^9, 3.960957533699316*^9}, {
  3.960957568257183*^9, 3.960957568748163*^9}, {3.9609577106328354`*^9, 
  3.960957719599859*^9}, {3.9609577505415*^9, 3.960957777193304*^9}, {
  3.9609578104454384`*^9, 3.9609578539009247`*^9}, {3.960958120898121*^9, 
  3.96095812936294*^9}, {3.9609583545977497`*^9, 3.9609583555794754`*^9}, {
  3.960960765708828*^9, 3.9609607667713966`*^9}, {3.960960842393114*^9, 
  3.9609608945142746`*^9}, {3.9609610736699066`*^9, 3.9609611005845947`*^9}, {
  3.9609766934596786`*^9, 3.960976697625555*^9}, {3.9609773118916473`*^9, 
  3.9609773122447987`*^9}, {3.9609778178429337`*^9, 3.960977817965481*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"5018f169-0cc4-5a46-91ca-b3da26f9b210"]
