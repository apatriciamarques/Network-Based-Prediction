Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating DegreeRotation gate...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetDegreeRotation", "[", 
     RowBox[{"v_Integer", ",", " ", "c_Integer"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"deg", ",", " ", "theta"}], "}"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{
       RowBox[{"deg", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"c", ",", "\n", "    ", "1", ",", " ", 
          RowBox[{"nodeDegrees", "[", 
           RowBox[{"[", "v", "]"}], "]"}], ",", "\n", "    ", "2", ",", " ", 
          RowBox[{"nodeDegreesC1", "[", 
           RowBox[{"[", "v", "]"}], "]"}], ",", "\n", "    ", "_", ",", " ", 
          RowBox[{"Return", "[", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], " ", "\n", 
         "  ", "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"deg", " ", "<", " ", "1"}], ",", " ", 
         RowBox[{"Return", "[", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}]}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"theta", " ", "=", " ", 
        RowBox[{"2", " ", 
         RowBox[{"ArcCos", "[", 
          RowBox[{"1", " ", "/", " ", "deg"}], "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"Wtheta", "[", "theta", "]"}]}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetDegreeRotation", "[", 
   RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetDegreeRotation", "[", 
   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
