Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating FeatureRotation gate...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetFeatureRotation", "[", 
     RowBox[{"v_Integer", ",", " ", "l_Integer"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "featVal"}], "}"}], ",", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Check", " ", "if", " ", "v", " ", "and", " ", "l", " ", "are", " ", 
        "valid", " ", "indices"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"If", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"1", " ", "<=", " ", "v", " ", "<=", " ", 
          RowBox[{"Length", "[", "adjacencyList", "]"}]}], " ", "&&", " ", 
         RowBox[{"1", " ", "<=", " ", "l", " ", "<=", " ", 
          RowBox[{"Length", "[", 
           RowBox[{"adjacencyList", "[", 
            RowBox[{"[", "v", "]"}], "]"}], "]"}]}]}], ",", "\n", "    ", 
        "\n", "    ", 
        RowBox[{
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"adjacencyList", "[", 
           RowBox[{"[", 
            RowBox[{"v", ",", " ", "l"}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"In", " ", "Mathematica"}], ",", " ", 
           RowBox[{"indexing", " ", "starts", " ", "at", " ", "1"}]}], " ", 
          "*)"}], "\n", "    ", 
         RowBox[{"featVal", " ", "=", " ", 
          RowBox[{"features", "[", 
           RowBox[{"[", "u", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Wval", "[", "featVal", "]"}]}], ",", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Return", " ", "identity", " ", "if", " ", "invalid"}], " ", 
         "*)"}], "\n", "    ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "\n", "  ", "]"}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
