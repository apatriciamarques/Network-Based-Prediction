Cell[CellGroupData[{

Cell["Classification", "Chapter",
 CellChangeTimes->{{3.960973830962879*^9, 
  3.9609738330114517`*^9}},ExpressionUUID->"41688454-fbdd-784f-ab74-\
98737861f2a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Train", "/", "Test"}], " ", "Set", " ", "Details"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"thClass", " ", "=", " ", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"classLabels", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"#", " ", "<", " ", "thClass"}], ",", " ", "0", ",", " ", 
         "1"}], "]"}], " ", "&"}], " ", "/@", " ", "features"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"wV", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"1", "/", "nrNodes"}], ",", " ", "nrNodes"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"wV", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", " ", 
        RowBox[{"1", "/", "6"}], ",", " ", 
        RowBox[{"1", "/", "6"}], ",", " ", 
        RowBox[{"1", "/", "6"}]}], "}"}]}], ";"}], " ", "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Class labels: \>\"", ",", " ", "classLabels"}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Features: \>\"", ",", " ", "features"}], "]"}], ";"}], " ",
     "*)"}], "\n", "\n", 
   RowBox[{
