Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Extracting the degrees...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nodeDegrees", " ", "=", " ", 
    RowBox[{"ToExpression", "[", 
     RowBox[{"degreesRaw", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", " ", ";;", " ", "6851"}], ",", " ", "3"}], "]"}], "]"}], 
     "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2", "nd", " ", "row"}], ",", " ", 
    RowBox[{"3", "rd", " ", "column"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Histogram", "[", 
   RowBox[{"nodeDegrees", ",", " ", "50", ",", "\n", "  ", 
    RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", 
    "  ", 
    RowBox[{"AxesLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Degree\>\"", ",", " ", "\"\<Frequency\>\""}], "}"}]}], ",",
     "\n", "  ", 
    RowBox[{"PlotLabel", " ", "->", " ", "\"\<Degree Distribution\>\""}], ",",
     "\n", "  ", 
    RowBox[{"ScalingFunctions", " ", "->", " ", "\"\<Log\>\""}]}], "\n", 
   "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Extracting the features...\>\"", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Features"}]}], " ", "vector", " ", "aligned", " ", 
     "to", " ", "node", " ", 
     RowBox[{"indices", " ", "--"}]}], "-"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"features", " ", "=", " ", 
    RowBox[{"ToExpression", "[", 
     RowBox[{"featuresRaw", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", " ", ";;", " ", "6851"}], ",", " ", "4"}], "]"}], "]"}], 
     "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2", "nd", " ", "row"}], ",", " ", 
    RowBox[{"4", "th", " ", "column"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Histogram", "[", 
   RowBox[{"features", ",", " ", "100", ",", "\n", "  ", 
    RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", 
    "  ", 
    RowBox[{"AxesLabel", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<-log10 Mutsig P-values\>\"", ",", " ", "\"\<Frequency\>\""}], 
      "}"}]}], ",", "\n", "  ", 
    RowBox[{
    "PlotLabel", " ", "->", " ", 
     "\"\<Distribution of -log10 Mutsig P-values\>\""}], ",", "\n", "  ", 
    RowBox[{"ScalingFunctions", " ", "->", " ", "\"\<Log\>\""}]}], "\n", 
   "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Creating the adjacency list...\>\"", "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", "Adjacency"}]}], " ", 
    RowBox[{"list", ":", " ", 
     RowBox[{
      RowBox[{
      "each", " ", "edge", " ", "is", " ", "added", " ", "in", " ", "both", 
       " ", 
       RowBox[{"directions", " ", "--"}]}], "-"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"nrNodes", " ", "=", " ", 
   RowBox[{"Length", "[", "nodeDegrees", "]"}]}], ";", " ", 
  RowBox[{"n", " ", "=", " ", 
   RowBox[{"Ceiling", "[", 
    RowBox[{"Log2", "[", "nrNodes", "]"}], "]"}]}], ";", " ", 
  RowBox[{"bigN", " ", "=", " ", 
   RowBox[{"2", "^", "n"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"adjacencyList", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", " ", 
     RowBox[{"{", "nrNodes", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Scan", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"adjacencyList", "[", 
          RowBox[{"[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"adjacencyList", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{
         RowBox[{"adjacencyList", "[", 
          RowBox[{"[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"adjacencyList", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], ")"}], " ", "&"}], 
     ",", "\n", "  ", 
     RowBox[{"Map", "[", 
      RowBox[{"ToExpression", ",", " ", 
