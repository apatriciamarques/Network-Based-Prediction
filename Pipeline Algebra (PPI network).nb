Cell[CellGroupData[{

Cell["\<\
c=2: Feature Embeddings for (v, l1, l2, i) - Taking a while for real-sized Net\
\>", "Chapter",
 CellChangeTimes->{{3.9608817820336933`*^9, 3.960881790539711*^9}, {
  3.960978309499056*^9, 
  3.9609783172933064`*^9}},ExpressionUUID->"2da19cb4-e11a-6b45-af53-\
7dd2c037883f"],

Cell[TextData[{
 StyleBox["Second-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, l1, l2), get the 16 feature vectors (for each i, l1, l2) of \
dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "2^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a82c5863-a731-da4b-a514-bacc76f128c0"],
 " = 16 (corresponding to 4 ancilla rotations)."
}], "Text",
 CellChangeTimes->{{3.960882004346836*^9, 3.9608820097096024`*^9}, {
  3.9608843554930553`*^9, 
  3.960884368137497*^9}},ExpressionUUID->"d62d2079-5248-c04d-ba4e-\
7b659952ef73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Preprocess", ":", " ", 
    RowBox[{"group", " ", "firstHopStates", " ", "by", " ", "\"\<v\>\""}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"firstHopByV", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"firstHopStates", ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<v\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Creating secondHopStates...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"secondHopStates", " ", "=", " ", 
     RowBox[{
      RowBox[{"Reap", "[", "\n", "  ", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"v0", " ", "=", " ", "1"}], ",", " ", 
         RowBox[{"v0", " ", "<=", " ", "nrNodes"}], ",", " ", 
         RowBox[{"v0", "++"}], ",", "\n", "    ", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"l0", " ", "=", " ", "1"}], ",", " ", 
           RowBox[{"l0", " ", "<=", " ", "s"}], ",", " ", 
           RowBox[{"l0", "++"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"u0", " ", "=", " ", 
             RowBox[{"adjacencyList", "[", 
              RowBox[{"[", 
               RowBox[{"v0", ",", " ", "l0"}], "]"}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"neighborStates", " ", "=", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"firstHopByV", ",", " ", "u0", ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], ";", "  ", 
            RowBox[{"(*", " ", 
             RowBox[{"fast", "!"}], " ", "*)"}], "\n", "\n", "      ", 
            RowBox[{"Do", "[", "\n", "        ", 
             RowBox[{
              RowBox[{"Sow", "[", 
               RowBox[{"<|", "\n", "          ", 
                RowBox[{
                 RowBox[{"\"\<v\>\"", " ", "->", " ", "v0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<i\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<i\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<l0\>\"", " ", "->", " ", "l0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<u0\>\"", " ", "->", " ", "u0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<l1\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<l\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<u1\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<u\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<state\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<state\>\"", "]"}]}]}], "\n", 
                "        ", "|>"}], "]"}], ",", "\n", "        ", 
              RowBox[{"{", 
               RowBox[{"state", ",", " ", "neighborStates"}], "}"}]}], "\n", 
             "      ", "]"}], ";"}]}], "\n", "    ", "]"}]}], "\n", "  ", 
        "]"}], "\n", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"secondHopStates", " ", "//", " ", "TableForm"}], " ", "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"secondHopStates", ",", " ", 
       RowBox[{
        RowBox[{"#v", " ", "==", " ", "3"}], " ", "&"}]}], "]"}], " ", "//", 
     " ", "TableForm"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Scan", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"Norm", "[", "#state", "]"}], "]"}], " ", "&"}], ",", " ", 
      "secondHopStates"}], "]"}], " ", "*)"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Norm", " ", "=", " ", 
     RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}], "\n", 
   RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.960881962677244*^9, 3.960881963559326*^9}, {
   3.9608820577967873`*^9, 3.9608821026603203`*^9}, {3.960882143756563*^9, 
   3.960882165334717*^9}, {3.960882203931885*^9, 3.960882225726841*^9}, 
