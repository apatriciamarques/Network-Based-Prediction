Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "metrics"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"trueLabels", " ", "=", " ", 
     RowBox[{"results", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<TrueLabel\>\""}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"predLabels", " ", "=", " ", 
     RowBox[{"results", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<PredictedLabel\>\""}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"posClass", " ", "=", " ", "1"}], ";", " ", 
    RowBox[{"negClass", " ", "=", " ", "0"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"True", " ", 
      RowBox[{"Positives", ":", " ", "predicted"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"1", " ", "AND", " ", "true"}], " ", "=", " ", "1"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"tp", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"results", ",", " ", 
       RowBox[{"assoc_", " ", "/;", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"assoc", "[", "\"\<PredictedLabel\>\"", "]"}], " ", "==", 
          " ", "posClass"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"assoc", "[", "\"\<TrueLabel\>\"", "]"}], " ", "==", " ", 
          "posClass"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"False", " ", 
      RowBox[{"Positives", ":", " ", "predicted"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"1", " ", "AND", " ", "true"}], " ", "=", " ", "0"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"fp", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"results", ",", " ", 
       RowBox[{"assoc_", " ", "/;", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"assoc", "[", "\"\<PredictedLabel\>\"", "]"}], " ", "==", 
          " ", "posClass"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"assoc", "[", "\"\<TrueLabel\>\"", "]"}], " ", "==", " ", 
          "negClass"}]}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"False", " ", 
      RowBox[{"Negatives", ":", " ", "predicted"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"0", " ", "AND", " ", "true"}], " ", "=", " ", "1"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"fn", " ", "=", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"results", ",", " ", 
       RowBox[{"assoc_", " ", "/;", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"assoc", "[", "\"\<PredictedLabel\>\"", "]"}], " ", "==", 
          " ", "negClass"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"assoc", "[", "\"\<TrueLabel\>\"", "]"}], " ", "==", " ", 
          "posClass"}]}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"accuracy", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"results", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "\"\<Correct\>\""}], "]"}], "]"}], ",", 
         " ", "True"}], "]"}], "/", 
       RowBox[{"Length", "[", "results", "]"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"correct", " ", "/", " ", "all"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"precision", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tp", " ", "+", " ", "fp"}], " ", "==", " ", "0"}], ",", " ", 
       "0", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"tp", "/", 
         RowBox[{"(", 
          RowBox[{"tp", " ", "+", " ", "fp"}], ")"}]}], "]"}]}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"tp", " ", "/", " ", "all"}], " ", "predicted", " ", 
     "positives"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"recall", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tp", " ", "+", " ", "fn"}], " ", "==", " ", "0"}], ",", " ", 
       "0", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"tp", "/", 
         RowBox[{"(", 
          RowBox[{"tp", " ", "+", " ", "fn"}], ")"}]}], "]"}]}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"tp", " ", "/", " ", "all"}], " ", "real", " ", "positives"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"f1", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"precision", " ", "+", " ", "recall"}], " ", "==", " ", "0"}],
        ",", " ", "0", ",", " ", 
       RowBox[{"2", "*", "precision", "*", 
        RowBox[{"recall", "/", 
         RowBox[{"(", 
          RowBox[{"precision", " ", "+", " ", "recall"}], ")"}]}]}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Metrics", " ", "table"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"metricsTable", " ", "=", " ", 
     RowBox[{"Grid", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Metric\>\"", ",", " ", "\"\<Value\>\""}], "}"}], ",", 
         "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"\"\<Accuracy\>\"", ",", " ", "accuracy"}], "}"}], ",", 
         "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"\"\<Precision\>\"", ",", " ", "precision"}], "}"}], ",", 
         "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"\"\<Recall\>\"", ",", " ", "recall"}], "}"}], ",", "\n", 
         "   ", 
         RowBox[{"{", 
          RowBox[{"\"\<F1 Score\>\"", ",", " ", "f1"}], "}"}]}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"Frame", " ", "->", " ", "All"}]}], "\n", "]"}]}], ";"}], "\n",
    "\n", "metricsTable"}]}]], "Code",
