Cell[TextData[{
 "Given node v and neighbor index l, it retrieves the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "x2"}], TraditionalForm]],ExpressionUUID->
  "50d65c35-938e-0f40-ba97-c430aa61dfdf"],
 " feature rotation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "X"], "(", 
    RowBox[{"u", "=", 
     RowBox[{"r", "(", 
      RowBox[{"v", ",", "l"}], ")"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"79de5611-b394-7944-a272-ddb16481532f"],
 " to act on the 1-qubit ancilla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d947f83c-bfa0-1b4f-8119-a0ecad6cb4fd"],
 "."
}], "Text",
