Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<Creating the 'number of second-hop neighbors' table...\>\"", "]"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Sum"}]}], " ", "of", " ", 
     RowBox[{"neighbors", "'"}], " ", "degrees", " ", "for", " ", "each", " ", 
     RowBox[{"node", " ", "--"}]}], "-"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nodeDegreesC1", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"nodeDegrees", "[", 
        RowBox[{"[", 
         RowBox[{"adjacencyList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "nrNodes"}], "}"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"nodeCheck", " ", "=", " ", "13"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"neighborsCheck", " ", "=", " ", 
   RowBox[{"adjacencyList", "[", 
    RowBox[{"[", "nodeCheck", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Node: \>\"", ",", " ", "nodeCheck"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Degree: \>\"", ",", " ", 
    RowBox[{"nodeDegrees", "[", 
     RowBox[{"[", "nodeCheck", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Neighbors: \>\"", ",", " ", "neighborsCheck"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Neighbors' Degrees: \>\"", ",", " ", 
    RowBox[{"nodeDegrees", "[", 
     RowBox[{"[", "neighborsCheck", "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<C1 Degree (sum of neighbors' degrees): \>\"", ",", " ", 
    RowBox[{"nodeDegreesC1", "[", 
     RowBox[{"[", "nodeCheck", "]"}], "]"}]}], "]"}], ";"}]}], "Code",
