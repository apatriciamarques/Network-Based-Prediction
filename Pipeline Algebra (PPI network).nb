Cell["c=1: Feature Embeddings for (v, l, i)", "Chapter",
 CellChangeTimes->{{3.9573450227255077`*^9, 3.9573450307666073`*^9}, {
   3.95735274771541*^9, 3.9573527562329884`*^9}, {3.960873806362585*^9, 
