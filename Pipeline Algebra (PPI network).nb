Cell[CellGroupData[{

Cell["Superposition from firstHopsStates", "Chapter",
 CellChangeTimes->{{3.960885161035761*^9, 
  3.960885177805504*^9}},ExpressionUUID->"7d821e1e-6d77-3c42-9448-\
6a5f396d5cb2"],

Cell[TextData[{
 StyleBox["First-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, i), get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", "5"], 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2^5s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db99146c-a7ee-9042-b6a2-52f6bf4eb27c"],
 " = 64 (corresponding to 5 ancilla rotations and the l register)."
}], "Text",
 CellChangeTimes->{{3.960886579665493*^9, 3.9608866750481453`*^9}, {
  3.9608987115640182`*^9, 
  3.9608987869032974`*^9}},ExpressionUUID->"c4537851-f803-aa4a-a9c9-\
2c5728bbf498"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"groupedByVI", " ", "=", " ", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"firstHopStates", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#v", ",", " ", "#i"}], "}"}], " ", "&"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Creating firstHopSuperposedStates...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"firstHopSuperposedStates", " ", "=", " ", 
    RowBox[{"KeyValueMap", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"key", ",", " ", "states"}], "}"}], ",", "\n", "    ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c", " ", "=", " ", "1"}], ",", " ", "v", ",", " ", "i", 
            ",", " ", 
            RowBox[{"stateDim", " ", "=", " ", "16"}], ",", " ", 
            "combinedState", ",", " ", "HOnL", ",", " ", "hadState", ",", " ",
             "finalState", ",", " ", "degRotVec"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "i"}], "}"}], " ", "=", " ", "key"}], ";",
            "\n", "      ", "\n", "      ", 
           RowBox[{"combinedState", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"states", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "\"\<state\>\""}], "]"}], "]"}], 
             "]"}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"length", " ", "=", " ", 
             RowBox[{"s", " ", "*", " ", "16"}]}], " ", "*)"}], "\n", "\n", 
           "      ", 
           RowBox[{"HOnL", " ", "=", " ", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"Hl", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "stateDim", "]"}]}], "]"}]}], 
           ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"16", "s", " ", "x", " ", "16", "s", " ", "matrix"}], " ",
             "*)"}], "\n", "      ", 
           RowBox[{"hadState", " ", "=", " ", 
            RowBox[{
             RowBox[{"HOnL", " ", ".", " ", "combinedState"}], " ", "/", " ", 
             RowBox[{"Sqrt", "[", "s", "]"}]}]}], ";", "\n", "\n", "      ", 
           RowBox[{"degRotVec", " ", "=", " ", 
            RowBox[{
             RowBox[{"GetDegreeRotation", "[", 
              RowBox[{"v", ",", " ", "c"}], "]"}], " ", ".", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}]}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"length", " ", "2", " ", "vector"}], " ", "*)"}], "\n", 
           "      ", 
           RowBox[{"finalState", " ", "=", " ", 
