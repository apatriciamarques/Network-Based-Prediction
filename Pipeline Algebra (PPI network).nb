Cell[CellGroupData[{

Cell["c=2: Feature Embeddings for (v, l1, l2, i)", "Chapter",
 CellChangeTimes->{{3.9608817820336933`*^9, 3.960881790539711*^9}, {
  3.960978309499056*^9, 3.9609783172933064`*^9}, {3.964607896400652*^9, 
  3.964607896497856*^9}},ExpressionUUID->"2da19cb4-e11a-6b45-af53-\
7dd2c037883f"],

Cell[TextData[{
 StyleBox["Second-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, l1, l2), get the 4*1024*1024 feature vectors (for each i, l1, \
l2) of dim ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "2^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a82c5863-a731-da4b-a514-bacc76f128c0"],
 " = 16 (corresponding to 4 ancilla rotations)."
}], "Text",
 CellChangeTimes->{{3.960882004346836*^9, 3.9608820097096024`*^9}, {
  3.9608843554930553`*^9, 3.960884368137497*^9}, {3.9646081563017216`*^9, 
  3.964608163552992*^9}},ExpressionUUID->"d62d2079-5248-c04d-ba4e-\
7b659952ef73"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Preprocess", ":", " ", 
    RowBox[{"group", " ", "firstHopStates", " ", "by", " ", "\"\<v\>\""}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"firstHopByV", " ", "=", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"firstHopStates", ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<v\>\"", "]"}], " ", "&"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Creating secondHopStates...\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"secondHopStates", " ", "=", " ", 
     RowBox[{
      RowBox[{"Reap", "[", "\n", "  ", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"v0", " ", "=", " ", "1"}], ",", " ", 
         RowBox[{"v0", " ", "<=", " ", "nrNodes"}], ",", " ", 
         RowBox[{"v0", "++"}], ",", "\n", "    ", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"l0", " ", "=", " ", "1"}], ",", " ", 
           RowBox[{"l0", " ", "<=", " ", "s"}], ",", " ", 
           RowBox[{"l0", "++"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"u0", " ", "=", " ", 
             RowBox[{"adjacencyList", "[", 
              RowBox[{"[", 
               RowBox[{"v0", ",", " ", "l0"}], "]"}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"neighborStates", " ", "=", " ", 
             RowBox[{"Lookup", "[", 
              RowBox[{"firstHopByV", ",", " ", "u0", ",", " ", 
               RowBox[{"{", "}"}]}], "]"}]}], ";", "  ", 
            RowBox[{"(*", " ", 
             RowBox[{"fast", "!"}], " ", "*)"}], "\n", "\n", "      ", 
            RowBox[{"Do", "[", "\n", "        ", 
             RowBox[{
              RowBox[{"Sow", "[", 
               RowBox[{"<|", "\n", "          ", 
                RowBox[{
                 RowBox[{"\"\<v\>\"", " ", "->", " ", "v0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<i\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<i\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<l0\>\"", " ", "->", " ", "l0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<u0\>\"", " ", "->", " ", "u0"}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<l1\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<l\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<u1\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<u\>\"", "]"}]}], ",", "\n", 
                 "          ", 
                 RowBox[{"\"\<state\>\"", " ", "->", " ", 
                  RowBox[{"state", "[", "\"\<state\>\"", "]"}]}]}], "\n", 
                "        ", "|>"}], "]"}], ",", "\n", "        ", 
              RowBox[{"{", 
               RowBox[{"state", ",", " ", "neighborStates"}], "}"}]}], "\n", 
             "      ", "]"}], ";"}]}], "\n", "    ", "]"}]}], "\n", "  ", 
        "]"}], "\n", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.960881962677244*^9, 3.960881963559326*^9}, {
   3.9608820577967873`*^9, 3.9608821026603203`*^9}, {3.960882143756563*^9, 
   3.960882165334717*^9}, {3.960882203931885*^9, 3.960882225726841*^9}, 
   3.960882398921604*^9, {3.9608825637967644`*^9, 3.9608825669081383`*^9}, {
   3.9608826014364758`*^9, 3.9608826018422813`*^9}, {3.960882823283209*^9, 
   3.9608829574418144`*^9}, {3.9608830117833614`*^9, 
   3.9608830145420475`*^9}, {3.960883075057825*^9, 3.960883230917492*^9}, {
   3.960883302607395*^9, 3.960883341426735*^9}, {3.960883381232012*^9, 
   3.960883383132105*^9}, {3.9608834907993183`*^9, 3.9608835215965347`*^9}, {
   3.960883552723646*^9, 3.96088355355702*^9}, {3.960883593666662*^9, 
   3.9608835950399284`*^9}, {3.960883668759823*^9, 3.9608836827362556`*^9}, {
   3.9608837396483994`*^9, 3.9608837472895927`*^9}, {3.96088382169446*^9, 
   3.9608838224765472`*^9}, {3.960884081734947*^9, 3.9608840975819416`*^9}, {
   3.9608855129474583`*^9, 3.96088551391543*^9}, {3.960960003094124*^9, 
   3.9609600217863827`*^9}, {3.9609600578278522`*^9, 3.960960062422447*^9}, {
   3.9609631602382374`*^9, 3.9609631626560555`*^9}, 3.960963862733593*^9, {
   3.960976663715328*^9, 3.9609766670924377`*^9}, {3.960977303883255*^9, 
   3.9609773042081375`*^9}, {3.9609778080153847`*^9, 3.9609778081476326`*^9}, 
   3.960979110290491*^9, {3.9646082459180183`*^9, 
   3.9646082476322174`*^9}},ExpressionUUID->"47852646-dd38-124c-b4b4-\
40b0c32c6539"]
