Cell[CellGroupData[{

Cell["Superposition from firstHopsStates", "Chapter",
 CellChangeTimes->{{3.960885161035761*^9, 
  3.960885177805504*^9}},ExpressionUUID->"7d821e1e-6d77-3c42-9448-\
6a5f396d5cb2"],

Cell[TextData[{
 StyleBox["First-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, i), get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", "5"], 
         StyleBox["s", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2^5s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db99146c-a7ee-9042-b6a2-52f6bf4eb27c"],
 " = 64 (corresponding to 5 ancilla rotations and the l register)."
}], "Text",
 CellChangeTimes->{{3.960886579665493*^9, 3.9608866750481453`*^9}, {
  3.9608987115640182`*^9, 
  3.9608987869032974`*^9}},ExpressionUUID->"c4537851-f803-aa4a-a9c9-\
2c5728bbf498"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"groupedByVI", " ", "=", " ", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"firstHopStates", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#v", ",", " ", "#i"}], "}"}], " ", "&"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Creating firstHopSuperposedStates...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"firstHopSuperposedStates", " ", "=", " ", 
    RowBox[{"KeyValueMap", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"key", ",", " ", "states"}], "}"}], ",", "\n", "    ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c", " ", "=", " ", "1"}], ",", " ", "v", ",", " ", "i", 
            ",", " ", 
            RowBox[{"stateDim", " ", "=", " ", "16"}], ",", " ", 
            "combinedState", ",", " ", "HOnL", ",", " ", "hadState", ",", " ",
             "finalState", ",", " ", "degRotVec"}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "i"}], "}"}], " ", "=", " ", "key"}], ";",
            "\n", "      ", "\n", "      ", 
           RowBox[{"combinedState", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"states", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "\"\<state\>\""}], "]"}], "]"}], 
             "]"}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"length", " ", "=", " ", 
             RowBox[{"s", " ", "*", " ", "16"}]}], " ", "*)"}], "\n", "\n", 
           "      ", 
           RowBox[{"HOnL", " ", "=", " ", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"Hl", ",", " ", 
              RowBox[{"IdentityMatrix", "[", "stateDim", "]"}]}], "]"}]}], 
           ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"16", "s", " ", "x", " ", "16", "s", " ", "matrix"}], " ",
             "*)"}], "\n", "      ", 
           RowBox[{"hadState", " ", "=", " ", 
            RowBox[{
             RowBox[{"HOnL", " ", ".", " ", "combinedState"}], " ", "/", " ", 
             RowBox[{"Sqrt", "[", "s", "]"}]}]}], ";", "\n", "\n", "      ", 
           RowBox[{"degRotVec", " ", "=", " ", 
            RowBox[{
             RowBox[{"GetDegreeRotation", "[", 
              RowBox[{"v", ",", " ", "c"}], "]"}], " ", ".", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "0"}], "}"}]}]}], ";", "  ", 
           RowBox[{"(*", " ", 
            RowBox[{"length", " ", "2", " ", "vector"}], " ", "*)"}], "\n", 
           "      ", 
           RowBox[{"finalState", " ", "=", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"hadState", ",", " ", "degRotVec"}], "]"}], "]"}]}], 
           ";", "\n", "\n", "      ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{
             RowBox[{"\"\<c\>\"", " ", "->", " ", "c"}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<v\>\"", " ", "->", " ", "v"}], ",", "\n", 
             "        ", 
             RowBox[{"\"\<i\>\"", " ", "->", " ", "i"}], ",", "\n", 
             "        ", 
             RowBox[{
             "\"\<stateCombined\>\"", " ", "->", " ", "combinedState"}], ",", 
             "\n", "        ", 
             RowBox[{"\"\<stateHadamardL\>\"", " ", "->", " ", "hadState"}], 
             ",", "\n", "        ", 
             RowBox[{"\"\<degRotVec\>\"", " ", "->", " ", "degRotVec"}], ",", 
             "\n", "        ", 
             RowBox[{
             "\"\<stateDegreeRotated\>\"", " ", "->", " ", "finalState"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", "groupedByVI"}], "\n", "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"firstHopSuperposedStates", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&&", " ", 
       RowBox[{"#i", " ", "==", " ", "4"}]}], " ", "&"}]}], "]"}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#stateDegreeRotated", "]"}], "]"}], " ", "&"}], 
     ",", " ", "firstHopSuperposedStates"}], "]"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.960885182041586*^9, 3.9608852144054546`*^9}, 
   3.960885256818121*^9, {3.9608852932758064`*^9, 3.9608852975259895`*^9}, {
   3.9608853790478783`*^9, 3.9608853987753887`*^9}, {3.9608854329253826`*^9, 
   3.9608854881800823`*^9}, {3.9608859283285046`*^9, 3.960886028565401*^9}, {
   3.960886092009451*^9, 3.9608861363453465`*^9}, {3.9608862612785892`*^9, 
   3.9608862629952087`*^9}, {3.9608863347552223`*^9, 3.9608863841868534`*^9}, 
   3.9608864151354294`*^9, {3.9608864469416714`*^9, 3.96088644779998*^9}, {
   3.960886483495163*^9, 3.96088648403677*^9}, {3.960886523628664*^9, 
   3.9608865523051662`*^9}, {3.960886884695154*^9, 3.9608869028455906`*^9}, {
   3.9608869513752594`*^9, 3.9608872038355274`*^9}, {3.960887256385103*^9, 
   3.9608873188887844`*^9}, {3.9608873539328327`*^9, 
   3.9608874819454575`*^9}, {3.9608875353499966`*^9, 
   3.9608876075611362`*^9}, {3.9608876698455105`*^9, 
   3.9608876755355377`*^9}, {3.960887742004986*^9, 3.9608877634354877`*^9}, {
   3.9608878055351944`*^9, 3.9608878230202866`*^9}, {3.960887871267149*^9, 
   3.9608878748855324`*^9}, {3.9608879509926357`*^9, 3.960887964897812*^9}, {
   3.9608982017713146`*^9, 3.960898206524189*^9}, {3.9608984026553993`*^9, 
   3.9608984060036335`*^9}, {3.960898453436903*^9, 3.960898453554697*^9}, {
   3.9608984840840435`*^9, 3.960898486146866*^9}, {3.960898517023987*^9, 
   3.9608985231025066`*^9}, {3.960898574284336*^9, 3.9608985881411133`*^9}, {
   3.960960053235098*^9, 3.9609601093275433`*^9}, {3.9609631545721855`*^9, 
   3.9609631568637943`*^9}, {3.9609766697384872`*^9, 3.960976677241171*^9}, {
   3.9609773062666283`*^9, 3.9609773066001797`*^9}, {3.9609778130080204`*^9, 
   3.960977813136076*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"ff95f73a-fa79-2e45-9240-80fbb5340751"]
