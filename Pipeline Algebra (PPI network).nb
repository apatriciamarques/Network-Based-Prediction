   3.9608816618967056`*^9, {3.960881746936983*^9, 
   3.9608817484971333`*^9}},ExpressionUUID->"f0490303-f8e8-fb42-8c82-\
e6b16d81e500"],

Cell[TextData[{
 StyleBox["First-hop neighborhood: ",
  FontWeight->"Bold"],
 "For each (v, l), get the 4*1024 feature vectors (for each i, l) of \
dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", "4"], TraditionalForm], "errors" -> {}, "input" -> 
     "2^4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73c443b7-deb9-f14d-9f32-6ab8c553fd1b"],
 " = 16 (corresponding to 4 ancilla rotations)."
}], "Text",
 CellChangeTimes->{{3.9608738352809772`*^9, 3.9608738560060825`*^9}, {
  3.9608739718891144`*^9, 3.960874007562275*^9}, {3.9608741293890934`*^9, 
  3.960874130453747*^9}, {3.9608741770133705`*^9, 3.9608741783125095`*^9}, {
  3.9608757658900833`*^9, 3.9608758296182137`*^9}, {3.96087591488006*^9, 
  3.960875929339657*^9}, {3.960877707391222*^9, 3.9608777286199474`*^9}, {
  3.9608809787705917`*^9, 3.9608809949532013`*^9}, {3.960881566168789*^9, 
  3.9608815845708714`*^9}, {3.960881983536705*^9, 3.9608819872431755`*^9}, {
  3.960884276626549*^9, 3.960884350836025*^9}, {3.9646077588370113`*^9, 
  3.9646077698430004`*^9}, {3.9646081079440517`*^9, 3.964608112470127*^9}, {
  3.9646081435698814`*^9, 
  3.964608144806589*^9}},ExpressionUUID->"fd543ce7-4948-ec4f-8824-\
4d9ada1ebecf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "\"\<Creating firstHopStates...\>\"", "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"firstHopStates", " ", "=", " ", 
   RowBox[{
    RowBox[{"Reap", "[", "\n", "  ", 
     RowBox[{"Do", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"featVec", " ", "=", " ", 
         RowBox[{
          RowBox[{"GetFeatureRotation", "[", 
           RowBox[{"v", ",", " ", "l"}], "]"}], " ", ".", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "0"}], "}"}]}]}], ";", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<v: \>\"", ",", " ", "v", ",", " ", "\"\<, l: \>\"", ",", " ", 
            "l", ",", " ", "\"\<, i: \>\"", ",", " ", "i"}], "]"}], "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Precompute", " ", "all", " ", "Kronecker", " ", "combinations", 
            " ", "once", " ", "for", " ", "each", " ", "featVec"}], " ", 
           "*)"}], "\n", "    ", "vectListBase"}], " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"Do", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"vectList", " ", "=", " ", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{"vectListBase", ",", " ", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"k", " ", "->", " ", "featVec"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", "1", ",", " ", "i"}], "}"}]}], 
               "]"}]}], "]"}]}], ";", "\n", "      ", 
           RowBox[{"combinedVec", " ", "=", " ", 
            RowBox[{
             RowBox[{"Fold", "[", 
              RowBox[{"KroneckerProduct", ",", " ", 
               RowBox[{"First", "[", "vectList", "]"}], ",", " ", 
               RowBox[{"Rest", "[", "vectList", "]"}]}], "]"}], " ", "//", 
             " ", "Flatten"}]}], ";", "\n", "      ", 
           RowBox[{"Sow", "[", 
            RowBox[{"<|", "\n", "        ", 
             RowBox[{
              RowBox[{"\"\<v\>\"", " ", "->", " ", "v"}], ",", "\n", 
              "        ", 
              RowBox[{"\"\<i\>\"", " ", "->", " ", "i"}], ",", "\n", 
              "        ", 
              RowBox[{"\"\<l\>\"", " ", "->", " ", "l"}], ",", "\n", 
              "        ", 
              RowBox[{"\"\<u\>\"", " ", "->", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"1", " ", "<=", " ", "l", " ", "<=", " ", 
                  RowBox[{"nodeDegrees", "[", 
                   RowBox[{"[", "v", "]"}], "]"}]}], ",", " ", 
                 RowBox[{"adjacencyList", "[", 
                  RowBox[{"[", 
                   RowBox[{"v", ",", " ", "l"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"nrNodes", " ", "+", " ", "1"}]}], "]"}]}], ",", " ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{
                "OL", " ", "oracle", " ", "flag", " ", "*", " ", "is", " ", 
                 "nrNodes"}], " ", "+", " ", "1"}], " ", "*)"}], "\n", 
              "        ", 
              RowBox[{"\"\<featVec\>\"", " ", "->", " ", "featVec"}], ",", 
              "\n", "        ", 
              RowBox[{"\"\<state\>\"", " ", "->", " ", "combinedVec"}]}], 
             "\n", "      ", "|>"}], "]"}]}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", "4"}], "}"}]}], "\n", "    ",
          "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", "1", ",", " ", "nrNodes"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "1", ",", " ", "s"}], "}"}]}], "\n", "  ", 
      "]"}], "\n", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{{3.9573425583666706`*^9, 3.9573427739069195`*^9}, {
   3.9573428844051685`*^9, 3.957342953591305*^9}, {3.95734301859424*^9, 
   3.957343107886881*^9}, {3.957343181806303*^9, 3.9573432296526604`*^9}, {
   3.9573433596908073`*^9, 3.9573433769318867`*^9}, {3.957343444055649*^9, 
   3.957343454889324*^9}, {3.9573435676898575`*^9, 3.9573435858190594`*^9}, {
   3.957343639386223*^9, 3.957343804299303*^9}, {3.957343902862076*^9, 
   3.9573439714220753`*^9}, {3.957344006244444*^9, 3.957344077049816*^9}, {
   3.957344107467907*^9, 3.95734417771566*^9}, {3.957344291379278*^9, 
