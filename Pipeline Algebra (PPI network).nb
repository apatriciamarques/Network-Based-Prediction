Cell[CellGroupData[{

Cell["Swap-Test Classifier", "Title",
 CellChangeTimes->{{3.957350740926771*^9, 3.9573507429427814`*^9}, {
  3.957356608744108*^9, 
  3.957356612932764*^9}},ExpressionUUID->"616b9c01-a8ad-fc4d-8b21-\
c714cfd01f49"],

Cell[TextData[{
 StyleBox["Expectation value of the product of two Pauli-Z operators ",
  FontWeight->"Bold"],
 "acting on the ancilla qubits of the quantum classifier\[CloseCurlyQuote]s \
state.\nIt ",
 StyleBox["measures their correlation",
  FontWeight->"Bold"],
 " and ",
 StyleBox["captures the similarity",
  FontWeight->"Bold"],
 " between the test data and training data. "
}], "Text",
 CellChangeTimes->{{3.9609614801725674`*^9, 3.9609614970001125`*^9}, {
  3.960961539605177*^9, 
  3.9609617048367577`*^9}},ExpressionUUID->"0ac98cc4-5925-cd4c-b703-\
ebc097da6612"],

