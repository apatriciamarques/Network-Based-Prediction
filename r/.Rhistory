cgc_genes <- read_csv("CGC.csv")  # with column: gene (723 genes causally implicated in cancer)
print("Let's start our dataset gathering.")
V(g)$label <- ifelse(V(g)$name %in% cgc_genes$gene, 1, 0) # 1 if in CGC, 0 otherwise
