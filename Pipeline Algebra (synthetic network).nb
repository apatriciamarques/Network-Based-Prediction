  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
