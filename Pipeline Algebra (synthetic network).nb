Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Parameters", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"n", " ", "=", " ", "6"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Number", " ", "of", " ", "qubits", " ", "for"}], " ", "|", 
     "j\:27e9"}], " ", "*)"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"14", " ", "2"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"m", " ", "=", " ", "2"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Number", " ", "of", " ", "qubits", " ", "for"}], " ", "|", 
     "k\:27e9"}], " ", "*)"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"4", " ", "1"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Derived", " ", "quantities"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nrNodes", " ", "=", " ", 
     RowBox[{"2", "^", "n"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Number", " ", "of", " ", "nodes"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"s", " ", "=", " ", 
     RowBox[{"2", "^", "m"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Sparsity", " ", "level"}], " ", "*)"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Number of Nodes: \>\"", ",", " ", "nrNodes"}], "]"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Initialize", " ", "adjacency", " ", "matrix"}], " ", "*)"}], 
   "\n", 
   RowBox[{"Print", "[", "\"\<Creating the Adjacency Matrix...\>\"", "]"}], 
   "\n", 
   RowBox[{
    RowBox[{"A", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"nrNodes", ",", " ", "nrNodes"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Circulant", " ", "graph", " ", "shifts"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"shifts", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", " ", "<=", " ", "2"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"s", "/", "2"}]}], "]"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"s", "/", "2"}]}], "]"}]}]}], "]"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Build", " ", "adjacency", " ", "list", " ", "and", " ", "adjacency", " ",
      "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"adjacencyList", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vList", " ", "=", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"i", " ", "+", " ", "shifts"}], ",", " ", "nrNodes", ",",
              " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Update", " ", "adjacency", " ", "matrix"}], " ", "*)"}], 
         "\n", "    ", 
         RowBox[{
          RowBox[{"Scan", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"A", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", " ", "#"}], "]"}], "]"}], " ", "=", " ", 
                "1"}], ";", " ", 
               RowBox[{
                RowBox[{"A", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
                "1"}]}], ")"}], " ", "&"}], ",", " ", "vList"}], "]"}], ";", 
          "\n", "    ", "vList"}]}], "\n", "    ", "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "nrNodes"}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacency Matrix (Sparse):\>\"", ",", " ", 
       RowBox[{"MatrixForm", "[", "A", "]"}]}], "]"}], ";", " ", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Adjacency List:\>\"", ",", " ", "adjacencyList"}], "]"}], 
     ";"}], " ", "*)"}], "\n", 
   RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Calculate", " ", "node", " ", "degrees"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nodeDegrees", " ", "=", " ", 
     RowBox[{"Length", " ", "/@", " ", "adjacencyList"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Calculate", " ", "second"}], "-", 
     RowBox[{
     "order", " ", "node", " ", "degrees", " ", "using", " ", "squared", " ", 
      "adjacency", " ", "matrix"}]}], " ", "*)"}], "\n", 
   RowBox[{"Print", "[", "\"\<Creating the A2...\>\"", "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"A2", " ", "=", " ", 
      RowBox[{"A", " ", ".", " ", "A"}]}], ";", " ", "\n", 
     RowBox[{"nodeDegreesC1", " ", "=", " ", 
      RowBox[{"Total", "[", 
       RowBox[{"A2", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"nodeDegreesC1", " ", "=", " ", 
     RowBox[{"nodeDegrees", "^", "2"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", "approximation", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Calculate", " ", "m_c1"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
      "bits", " ", "needed", " ", "to", " ", "represent", " ", "max", " ", 
       "second"}], "-", 
      RowBox[{"order", " ", "degree"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"mC1", " ", "=", " ", 
     RowBox[{"Ceiling", "[", 
      RowBox[{"Log2", "[", 
       RowBox[{"Max", "[", "nodeDegreesC1", "]"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<m_c1 (bits for 2nd order degrees): \>\"", ",", " ", "mC1"}],
      "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Sparsity", " ", "level", " ", "for", " ", "c1"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"sC1", " ", "=", " ", 
     RowBox[{"2", "^", "mC1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<s_c1 (2^m_c1): \>\"", ",", " ", "sC1"}], "]"}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"For", " ", "the", " ", "features"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"p", " ", "=", " ", "n"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Precision", " ", "level"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"P", " ", "=", " ", 
     RowBox[{"2", "^", "p"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Scaling", " ", "factor"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Feature", " ", "vector", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"descending", " ", "from", " ", "1"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"1", "/", "P"}], " ", "to", " ", "0"}]}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"features", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"1", "/", "P"}]}], ",", " ", "0", ",", " ", 
          RowBox[{"nrNodes", " ", "-", " ", "1"}]}], "]"}], ",", " ", 
        "0.0000000001"}], "]"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{"0", ",", " ", "0.7", ",", " ", "0.3", ",", " ", "1"}], "]"}], 
     ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"featuresInt", " ", "=", " ", 
     RowBox[{"Round", "[", 
      RowBox[{"features", " ", "*", " ", "P"}], "]"}]}], ";"}]}]}]], "Code",
