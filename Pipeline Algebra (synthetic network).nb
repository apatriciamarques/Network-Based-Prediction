   3.960872402042757*^9}},ExpressionUUID->"6401ccb3-9e95-8140-9194-\
a82c057a6f1b"],

Cell[TextData[{
 "Given node v and neighbor index l, it retrieves the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "x2"}], TraditionalForm]],ExpressionUUID->
  "50d65c35-938e-0f40-ba97-c430aa61dfdf"],
 " feature rotation matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "X"], "(", 
    RowBox[{"u", "=", 
     RowBox[{"r", "(", 
      RowBox[{"v", ",", "l"}], ")"}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"79de5611-b394-7944-a272-ddb16481532f"],
 " to act on the 1-qubit ancilla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d947f83c-bfa0-1b4f-8119-a0ecad6cb4fd"],
 "."
}], "Text",
 CellChangeTimes->{{3.960870030187134*^9, 3.960870061205042*^9}, {
  3.960870173675173*^9, 3.960870202378519*^9}, {3.9608702387747746`*^9, 
  3.960870360245056*^9}, {3.9608725523002186`*^9, 
  3.960872575793049*^9}},ExpressionUUID->"7261d187-7248-864c-9644-\
ea3d853fc7af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating FeatureRotation gate...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetFeatureRotation", "[", 
     RowBox[{"v_Integer", ",", " ", "l_Integer"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "featVal"}], "}"}], ",", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Check", " ", "if", " ", "v", " ", "and", " ", "l", " ", "are", " ", 
        "valid", " ", "indices"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"If", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"1", " ", "<=", " ", "v", " ", "<=", " ", 
          RowBox[{"Length", "[", "adjacencyList", "]"}]}], " ", "&&", " ", 
         RowBox[{"1", " ", "<=", " ", "l", " ", "<=", " ", 
          RowBox[{"Length", "[", 
           RowBox[{"adjacencyList", "[", 
            RowBox[{"[", "v", "]"}], "]"}], "]"}]}]}], ",", "\n", "    ", 
        "\n", "    ", 
        RowBox[{
         RowBox[{"u", " ", "=", " ", 
          RowBox[{"adjacencyList", "[", 
           RowBox[{"[", 
            RowBox[{"v", ",", " ", "l"}], "]"}], "]"}]}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"In", " ", "Mathematica"}], ",", " ", 
           RowBox[{"indexing", " ", "starts", " ", "at", " ", "1"}]}], " ", 
          "*)"}], "\n", "    ", 
         RowBox[{"featVal", " ", "=", " ", 
          RowBox[{"features", "[", 
           RowBox[{"[", "u", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Wval", "[", "featVal", "]"}]}], ",", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Return", " ", "identity", " ", "if", " ", "invalid"}], " ", 
         "*)"}], "\n", "    ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "\n", "  ", "]"}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "\n", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"GetFeatureRotation", "[", 
   RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
 CellChangeTimes->{
