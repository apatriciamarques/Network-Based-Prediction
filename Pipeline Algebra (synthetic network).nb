Cell[TextData[{
 "Translate the quantum circuit operations into purely matrix/vector-based \
operations (i.e., classical linear algebra). \|01f483\n",
 StyleBox["Represent Qubits and Registers as Vector Spaces\n- ",
  FontWeight->"Bold"],
 "Each qubit is a 2D complex vector space with computational basis \
\[Divides]0\:27e9 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"1"},
      {"0"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "fd16ad29-6dde-b34b-87ec-de213454464d"],
 " and \[Divides]1\:27e9 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"0"},
      {"1"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "dbf23200-43f0-e84e-a904-263833740736"],
 ".\n",
 StyleBox["-",
  FontWeight->"Bold"],
 " An \|01d45b-qubit register corresponds to a tensor product space of \
dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "\|01d45b"], TraditionalForm]],ExpressionUUID->
  "e825d261-94b5-b545-bb59-21d210d3a530"],
 ".\n",
 StyleBox["- ",
  FontWeight->"Bold"],
 "A full quantum state is a normalized vector in this space.\n- Initialize \
the nodes in an ",
 StyleBox["equal superposition",
  FontWeight->"Bold"],
 ", not with different ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["w", "TI"], 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "w_m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dabd8556-1a51-7f47-a578-9bc290712282"],
 "."
}], "Text",
 CellChangeTimes->{{3.9573421055686035`*^9, 3.9573421432475166`*^9}, {
  3.959674822305094*^9, 3.959674870846363*^9}, {3.959674901387594*^9, 
  3.9596750569683304`*^9}, {3.9609597477900066`*^9, 
  3.9609597849097157`*^9}},ExpressionUUID->"2204cb53-8131-ef43-a2d0-\
ad67ee9eab55"]
}, Open  ]],

