Cell[CellGroupData[{

Cell["Swap-Test Classifier", "Title",
 CellChangeTimes->{{3.957350740926771*^9, 3.9573507429427814`*^9}, {
  3.957356608744108*^9, 
  3.957356612932764*^9}},ExpressionUUID->"616b9c01-a8ad-fc4d-8b21-\
c714cfd01f49"],

Cell[TextData[{
 StyleBox["Expectation value of the product of two Pauli-Z operators ",
  FontWeight->"Bold"],
 "acting on the ancilla qubits of the quantum classifier\[CloseCurlyQuote]s \
state.\nIt ",
 StyleBox["measures their correlation",
  FontWeight->"Bold"],
 " and ",
 StyleBox["captures the similarity",
  FontWeight->"Bold"],
 " between the test data and training data. "
}], "Text",
 CellChangeTimes->{{3.9609614801725674`*^9, 3.9609614970001125`*^9}, {
  3.960961539605177*^9, 
  3.9609617048367577`*^9}},ExpressionUUID->"0ac98cc4-5925-cd4c-b703-\
ebc097da6612"],

Cell[CellGroupData[{

Cell["Kernel Matrix on Training Data", "Chapter",
 CellChangeTimes->{{3.960973813699375*^9, 
  3.960973818131359*^9}},ExpressionUUID->"be24513f-7108-574a-8b21-\
60e7290bd0d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"trainVecs", " ", "=", " ", 
   RowBox[{"Values", "[", "superLongVectorsByV", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nPower", " ", "=", " ", "1"}], ";"}], "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Creating Kernel Matrix Table...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kernelMatrix", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"trainVecs", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"trainVecs", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "nPower"}], ")"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Dimensions", "[", "kernelMatrix", "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"should", " ", "be", " ", 
    RowBox[{"{", 
     RowBox[{"nrNodes", ",", " ", "nrNodes"}], "}"}]}], " ", "*)"}], 
  "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Creating Kernel Matrix Heatmap...\>\"", 
  "]"}], "\n", 
 RowBox[{"Legended", "[", "\n", " ", 
  RowBox[{
   RowBox[{"MatrixPlot", "[", 
    RowBox[{"kernelMatrix", ",", "\n", "  ", 
     RowBox[{"ColorFunction", " ", "->", " ", "\"\<TemperatureMap\>\""}], ",",
      "\n", "  ", 
     RowBox[{"FrameTicks", " ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"PlotLabel", " ", "->", " ", "\"\<Kernel Matrix Heatmap\>\""}], 
     ",", "\n", "  ", 
     RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", " ", "]"}], ",", 
   "\n", " ", 
   RowBox[{"BarLegend", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<TemperatureMap\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Min", "[", "kernelMatrix", "]"}], ",", " ", 
         RowBox[{"Max", "[", "kernelMatrix", "]"}]}], "}"}]}], "}"}], ",", 
     " ", 
     RowBox[{"LegendLabel", " ", "->", " ", "\"\<Kernel Value\>\""}]}], 
    "]"}]}], "\n", "]"}]}], "Code",
 CellChangeTimes->{{3.9609618255204487`*^9, 3.9609618261890087`*^9}, 
