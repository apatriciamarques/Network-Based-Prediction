}], "Text",
 CellChangeTimes->{{3.9608738352809772`*^9, 3.9608738560060825`*^9}, {
  3.9608739718891144`*^9, 3.960874007562275*^9}, {3.9608741293890934`*^9, 
  3.960874130453747*^9}, {3.9608741770133705`*^9, 3.9608741783125095`*^9}, {
  3.9608757658900833`*^9, 3.9608758296182137`*^9}, {3.96087591488006*^9, 
  3.960875929339657*^9}, {3.960877707391222*^9, 3.9608777286199474`*^9}, {
  3.9608809787705917`*^9, 3.9608809949532013`*^9}, {3.960881566168789*^9, 
  3.9608815845708714`*^9}, {3.960881983536705*^9, 3.9608819872431755`*^9}, {
