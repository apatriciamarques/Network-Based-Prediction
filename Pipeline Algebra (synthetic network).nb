Cell[TextData[{
 StyleBox["Both neighborhoods: ",
  FontWeight->"Bold"],
 "For each (v, c, i), get the one feature vectors of dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", "5"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "2^5s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac796717-6f58-ed47-9d86-0ca3c8a354a4"],
 " = 128 (padded and unit-length)."
}], "Text",
 CellChangeTimes->{{3.960960947944906*^9, 
  3.960960996325865*^9}},ExpressionUUID->"1d523ca8-8a3d-b642-8647-\
595ab4b3bba2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", "\"\<Creating allSuperposedStates...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allSuperposedStates", " ", "=", " ", 
    RowBox[{"Join", "[", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{
        RowBox[{"1", ":", " ", 
         RowBox[{"pad", " ", "to", " ", 
          RowBox[{"2", "^", "5"}], " ", "*", " ", 
          RowBox[{"s", "^", "2"}]}]}], " ", "=", " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"5", "+", 
           RowBox[{"2", "m"}]}], ")"}]}]}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}], ",",
                " ", 
               RowBox[{
                RowBox[{"2", "^", "5"}], " ", "*", " ", 
                RowBox[{"s", "^", "2"}]}]}], "]"}]}], "\n", "      ", 
            "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", "    ", 
        "firstHopSuperposedStates"}], "\n", "  ", "]"}], ",", "\n", "\n", 
      "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"2", ":", " ", 
         RowBox[{"already", " ", "full", " ", "size"}]}]}], " ", "*)"}], "\n",
       "  ", 
      RowBox[{"Map", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"assoc", ",", "\n", "      ", 
          RowBox[{"assoc", " ", "~", "Join", "~", " ", 
           RowBox[{"<|", "\n", "        ", 
            RowBox[{"\"\<statePadded\>\"", " ", "->", " ", 
             RowBox[{"assoc", "[", "\"\<stateDegreeRotated\>\"", "]"}]}], 
            "\n", "      ", "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", 
        "    ", "secondHopSuperposedStates"}], "\n", "  ", "]"}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Map", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"assoc", ",", "\n", "    ", 
      RowBox[{"<|", "\n", "      ", 
       RowBox[{
        RowBox[{"\"\<c\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<c\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<i\>\"", " ", "->", " ", 
         RowBox[{"assoc", "[", "\"\<i\>\"", "]"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<stateLengthPadded\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"assoc", "[", "\"\<statePadded\>\"", "]"}], "]"}]}]}], "\n",
        "    ", "|>"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
    RowBox[{"Select", "[", 
     RowBox[{"allSuperposedStates", ",", " ", 
      RowBox[{
       RowBox[{"#v", " ", "==", " ", "2"}], " ", "&"}]}], "]"}]}], "\n", 
   "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Scan", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Norm", "[", "#statePadded", "]"}], "]"}], " ", "&"}], ",", 
     " ", "allSuperposedStates"}], "]"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Norm", " ", "=", " ", 
    RowBox[{"1", " ", "for", " ", "all"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"Print", "[", "\"\<Finished.\>\"", "]"}]}], "Code",
