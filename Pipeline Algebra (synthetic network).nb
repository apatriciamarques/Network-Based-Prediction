Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"trainLabels", " ", "=", " ", "classLabels"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "0", ",", " ", "0"}], "}"}], ";"}],
    " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"testIsTrain", " ", "=", " ", "True"}], "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Calculating Expectation Values...\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expectationValsAll", " ", "=", " ", 
    RowBox[{"If", "[", 
     RowBox[{"testIsTrain", ",", "\n", "  ", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "trainLabels"}], ")"}], " ", "*",
           " ", "wV", " ", "*", " ", 
          RowBox[{"kernelMatrix", "[", 
           RowBox[{"[", "v", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", 
          RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}]}], "\n", "  ", 
       "]"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"if", " ", "testIstrain"}], " ", "=", " ", "False"}], ",", 
        " ", 
        RowBox[{
        "exclude", " ", "self", " ", "from", " ", "kernel", " ", "row"}], ",",
         " ", 
        RowBox[{"labels", " ", "and", " ", "weights"}]}], " ", "*)"}], "\n", 
      "  ", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"idxs", " ", "=", " ", 
            RowBox[{"Delete", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "trainVecs", "]"}], "]"}], ",", " ", 
              "v"}], "]"}]}], "}"}], ",", "\n", "      ", 
          RowBox[{"Total", "[", "\n", "        ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"trainLabels", "[", 
               RowBox[{"[", "idxs", "]"}], "]"}]}], ")"}], " ", "*", " ", 
            RowBox[{"wV", "[", 
             RowBox[{"[", "idxs", "]"}], "]"}], " ", "*", " ", 
            RowBox[{"kernelMatrix", "[", 
             RowBox[{"[", 
              RowBox[{"v", ",", " ", "idxs"}], "]"}], "]"}]}], "\n", "      ",
            "]"}]}], "\n", "    ", "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"v", ",", " ", 
          RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}]}], "\n", "  ", 
       "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Print", "[", "\"\<Calculating Predicted Labels...\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"predictedLabels", " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"Sign", "[", "expectationValsAll", "]"}]}], ")"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"<|", "\n", "    ", 
       RowBox[{
        RowBox[{"\"\<Node\>\"", " ", "->", " ", "v"}], ",", "\n", "    ", 
        RowBox[{"\"\<ExpectationValue\>\"", " ", "->", " ", 
         RowBox[{"expectationValsAll", "[", 
          RowBox[{"[", "v", "]"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<TrueLabel\>\"", " ", "->", " ", 
         RowBox[{"trainLabels", "[", 
          RowBox[{"[", "v", "]"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<PredictedLabel\>\"", " ", "->", " ", 
         RowBox[{"predictedLabels", "[", 
          RowBox[{"[", "v", "]"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"\"\<Correct\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"predictedLabels", "[", 
            RowBox[{"[", "v", "]"}], "]"}], " ", "==", " ", 
           RowBox[{"trainLabels", "[", 
            RowBox[{"[", "v", "]"}], "]"}]}], ")"}]}]}], "\n", "  ", "|>"}], 
      ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"v", ",", " ", 
        RowBox[{"Length", "[", "trainVecs", "]"}]}], "}"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Print", " ", "/@", " ", "results"}], ";"}], " ", 
   "*)"}]}]}], "Code",
