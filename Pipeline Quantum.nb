       RowBox[{"0", ",", " ", 
        RowBox[{
         RowBox[{"2", "^", "nrQubitsCurrent"}], " ", "-", " ", "1"}]}], "]"}],
       ",", " ", "2", ",", " ", "nrQubitsCurrent"}], "]"}]}]}], "\n", 
  "\t"}], "\n", 
 RowBox[{
  RowBox[{"createBarChart", "[", "stateCurrent_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nrQubitsCurrent", " ", "=", " ", 
       RowBox[{"Log2", "[", 
        RowBox[{"Length", "[", "stateCurrent", "]"}], "]"}]}], ",", " ", 
      "labels"}], "}"}], ",", "\n", "  ", 
    RowBox[{
