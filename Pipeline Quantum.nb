       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"s", "/", "2"}]}], "]"}], ",", " ", 
         RowBox[{"-", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"s", "/", "2"}]}], "]"}]}]}], "]"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Build", " ", "adjacency", " ", "list", " ", "and", " ", "adjacency", " ",
      "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"adjacencyList", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vList", " ", "=", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"i", " ", "+", " ", "shifts"}], ",", " ", "nrNodes", ",",
              " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Update", " ", "adjacency", " ", "matrix"}], " ", "*)"}], 
         "\n", "    ", 
         RowBox[{
          RowBox[{"Scan", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"A", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", " ", "#"}], "]"}], "]"}], " ", "=", " ", 
                "1"}], ";", " ", 
               RowBox[{
                RowBox[{"A", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", ",", " ", "i"}], "]"}], "]"}], " ", "=", " ", 
                "1"}]}], ")"}], " ", "&"}], ",", " ", "vList"}], "]"}], ";", 
          "\n", "    ", "vList"}]}], "\n", "    ", "]"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "nrNodes"}], "}"}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
