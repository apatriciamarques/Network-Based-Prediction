   RowBox[{"(*", " ", 
    RowBox[{"Scaling", " ", "factor"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Initialize", " ", "adjacency", " ", "matrix"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"A", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"nrNodes", ",", " ", "nrNodes"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Circulant", " ", "graph", " ", "shifts"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"shifts", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"s", " ", "<=", " ", "2"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
