     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Feature Vector (scaled by P): \>\"", ",", " ", "featuresInt"}], 
     "]"}], ";"}]}]}]], "Code",
