        RowBox[{"1", "/", "P"}], " ", "to", " ", "0"}]}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"features", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"1", " ", "-", " ", 
