     RowBox[{"\"\<Node degrees squared: \>\"", ",", " ", "nodeDegreesC1"}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Feature", " ", "vector", " ", 
     RowBox[{"(", 
