     "k\:27e9"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"p", " ", "=", " ", "n"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Precision", " ", "level"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Derived", " ", "quantities"}], " ", "*)"}], "\n", 
