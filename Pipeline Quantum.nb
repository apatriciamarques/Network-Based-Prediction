        "\n", "    ", 
       RowBox[{"ChartLabels", " ", "->", " ", "labels"}], ",", "\n", "    ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Basis state\>\"", ",", " ", "\"\<Probability\>\""}], 
         "}"}]}], ",", "\n", "    ", 
       RowBox[{"ChartStyle", " ", "->", " ", "\"\<Rainbow\>\""}], ",", "\n", 
       "    ", 
       RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", "  ", 
      "]"}]}]}], "\n", "]"}]}]}], "Code",
