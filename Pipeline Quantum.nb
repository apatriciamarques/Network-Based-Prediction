    RowBox[{
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<|\>\"", ",", " ", "#", ",", " ", "\"\<\:27e9\>\""}], "]"}],
      " ", "&"}], " ", "/@", " ", 
